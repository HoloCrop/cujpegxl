from collections.abc import Sequence
from torch import Tensor

class Encoder:
    def __init__(self, width: int, height: int, distance: float, device_index: int = 0, pipeline_depth: int = 3) -> None: ...
    def encode(self, image: Tensor) -> bytes: ...
    def encode_batch(self, images: Sequence[Tensor] | Tensor) -> list[bytes]: ...
    def push(self, images: Sequence[Tensor]) -> list[bytes]: ...
    def flush(self) -> list[bytes]: ...

class Decoder:
    def __init__(self, width: int, height: int, device_index: int = 0) -> None: ...
    def decode(self, image: bytes) -> Tensor: ...
    def decode_batch(self, images: Sequence[bytes], maps: Tensor | None = None) -> Tensor: ...
